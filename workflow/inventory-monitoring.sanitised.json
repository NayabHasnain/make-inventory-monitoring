{
  "name": "Inventory Monitoring – Public Template",
  "flow": [
    {
      "id": 1,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {
        "tlsType": "",
        "authenticationType": "noAuth"
      },
      "mapper": {
        "url": "https://dummyjson.com/products?select=id,title,category,price,stock,sku&sortBy=stock&order=asc",
        "limit": "200",
        "method": "get",
        "shareCookies": false,
        "parseResponse": true,
        "allowRedirects": true,
        "paginationType": "offsetBased",
        "stopOnHttpError": true,
        "paginationOutputFormat": "items",
        "paginationRequestConfig": {
          "offsetParamName": "skip",
          "pageSizeParamName": "limit",
          "initialOffsetValue": "0",
          "pageSizeParamValue": "50"
        },
        "paginationResponseConfig": {
          "itemsPath": "products"
        },
        "requestCompressedContent": true
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {
          "expect": {
            "method": {
              "mode": "chose",
              "label": "GET"
            },
            "headers": {
              "mode": "chose"
            },
            "contentType": {
              "label": "Empty"
            },
            "shareCookies": {
              "mode": "chose"
            },
            "parseResponse": {
              "mode": "chose"
            },
            "allowRedirects": {
              "mode": "chose"
            },
            "paginationType": {
              "label": "Offset-basedUse when the API requires you to specify the offset (starting position) to retrieve the next set of results."
            },
            "queryParameters": {
              "mode": "chose"
            },
            "stopOnHttpError": {
              "mode": "chose"
            },
            "paginationOutputFormat": {
              "label": "Array of items"
            },
            "requestCompressedContent": {
              "mode": "chose"
            }
          },
          "parameters": {
            "tlsType": {
              "label": "Empty"
            },
            "authenticationType": {
              "label": "No authenticationUse when no credentials are required for the request."
            }
          }
        },
        "parameters": [
          {
            "name": "authenticationType",
            "type": "select",
            "label": "Authentication type",
            "required": true,
            "validate": {
              "enum": [
                "noAuth",
                "apiKey",
                "basicAuth",
                "oAuth"
              ]

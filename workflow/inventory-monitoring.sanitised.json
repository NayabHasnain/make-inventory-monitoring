          },
          {
            "name": "tlsType",
            "type": "select",
            "label": "Transport layer security (TLS)",
            "validate": {
              "enum": [
                "mTls",
                "tls"
              ]
            }
          },
          {
            "name": "proxyKeychain",
            "type": "keychain:proxy",
            "label": "Proxy"
          }
        ],
        "expect": [
          {
            "name": "url",
            "type": "url",
            "label": "URL",
            "required": true
          },
          {
            "name": "method",
            "type": "select",
            "label": "Method",
            "required": true,
            "validate": {
              "enum": [
                "get",
                "head",
                "post",
                "put",
                "patch",
                "delete",
                "options"
              ]
            }
          },
          {
            "name": "headers",
            "spec": {
              "name": "value",
              "spec": [
                {
                  "name": "name",
                  "type": "text",
                  "label": "Name",
                  "required": true,
                  "validate": {
                    "pattern": "^[-!#$%&'*+.^_`|~0-9A-Za-z]+$"
                  }
                },
                {
                  "name": "value",
                  "type": "text",
                  "label": "Value"
                }
              ],
              "type": "collection",
              "label": "Header"
            },
            "type": "array",
            "label": "Headers"
          },
          {
            "name": "queryParameters",
            "spec": {
              "name": "value",
              "spec": [
                {
                  "name": "name",
                  "type": "text",
                  "label": "Name",
                  "required": true
                },
                {
                  "name": "value",
                  "type": "text",
                  "label": "Value"
                }
              ],
              "type": "collection",
              "label": "Parameter"
            },
            "type": "array",
            "label": "Query parameters"
          },
          {
            "name": "contentType",
            "type": "select",
            "label": "Body content type",
            "validate": {
              "enum": [
                "json",
                "multipart",
                "urlEncoded",
                "custom"
              ]
            }
          },
          {
            "name": "parseResponse",
            "type": "boolean",
            "label": "Parse response",
            "required": true
          },
          {
            "name": "stopOnHttpError",
            "type": "boolean",
            "label": "Return error if HTTP request fails",
            "required": true
          },
          {
            "name": "timeout",
            "type": "uinteger",
            "label": "Timeout",
            "validate": {
              "max": 300,
              "min": 1
            }
          },
          {
            "name": "allowRedirects",
            "type": "boolean",
            "label": "Allow redirects",
            "required": true
          },
          {
            "name": "shareCookies",
            "type": "boolean",
            "label": "Share cookies with other HTTP modules",
            "required": true
          },
          {
            "name": "requestCompressedContent",
            "type": "boolean",
            "label": "Request compressed content",
            "required": true
          },
          {
            "name": "paginationType",
            "type": "select",
            "label": "Pagination type",
            "validate": {
              "enum": [
                "offsetBased",
                "pageBased",
                "urlBased",
                "tokenBased"
              ]
            }
          },
          {
            "name": "paginationResponseConfig",
            "spec": [
              {
                "name": "itemsPath",
                "type": "text",
                "label": "Items path"
              }
            ],
            "type": "collection",
            "label": "Pagination response config"
          },
          {
            "name": "paginationRequestConfig",
            "spec": [
              {
                "name": "offsetParamName",
                "type": "text",
                "label": "Offset parameter name",
                "required": true
              },
              {
                "name": "initialOffsetValue",
                "type": "uinteger",
                "label": "Initial offset value",
                "required": true
              },
              {
                "name": "pageSizeParamName",
                "type": "text",
                "label": "Page size parameter name"
              },
              {
                "name": "pageSizeParamValue",
                "type": "uinteger",
                "label": "Page size parameter value"
              }
            ],
            "type": "collection",
            "label": "Pagination request config"
          },
          {
            "name": "paginationOutputFormat",
            "type": "select",
            "label": "Output format",
            "required": true,
            "validate": {
              "enum": [
                "items",
                "pages"
              ]
            }
          },
          {
            "name": "limit",
            "type": "uinteger",
            "label": "Limit",
            "required": true,
            "validate": {
              "max": 10000,
              "min": 1
            }
          }
        ],
        "interface": [
          {
            "name": "__IMTLENGTH__",
            "type": "number",
            "label": "Total number of bundles"
          },
          {
            "name": "__IMTINDEX__",
            "type": "number",
            "label": "Bundle order position"
          }
        ],
        "advanced": true
      }
    },
    {
      "id": 5,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "variables": [
          {
            "name": "inventory_value",
            "value": "{{1.price * 1.stock}}"
          },
          {
            "name": "reorder_quantity",
            "value": "{{if(1.stock < 20; 20 - 1.stock; 0)}}"
          },
          {
            "name": "stock_status",
            "value": "{{if(1.stock <= 5; \"Critical \"; if(1.stock <= 10; \"Low Stock\"; \"Healthy\"))}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        },
        "restore": {
          "expect": {
            "scope": {
              "label": "One cycle"
            },
            "variables": {
              "items": [
                null,
                null,
                null
              ]
            }
          }
        },
        "expect": [
          {
            "name": "variables",
            "spec": {
              "name": "value",
              "spec": [
                {
                  "name": "name",
                  "type": "text",
                  "label": "Variable name",
                  "required": true
                },
                {
                  "name": "value",
                  "type": "any",
                  "label": "Variable value"
                }
              ],
              "type": "collection",
              "label": "Variable"
            },
            "type": "array",
            "label": "Variables",
            "validate": {
              "unique": {
                "by": "name"
              },
              "minItems": 1
            }
          },
          {
            "name": "scope",
            "type": "select",
            "label": "Variable lifetime",
            "required": true,
            "validate": {
              "enum": [
                "roundtrip",
                "execution"
              ]
            }
          }
        ],
        "interface": [
          {
            "name": "inventory_value",
            "type": "any",
            "label": "inventory_value"
          },
          {
            "name": "reorder_quantity",
            "type": "any",
            "label": "reorder_quantity"
          },
          {
            "name": "stock_status",
            "type": "any",
            "label": "stock_status"
          }
        ]
      }
    },
    {
      "id": 6,
      "module": "util:TextAggregator",
      "version": 1,
      "parameters": {
        "feeder": 1,
        "rowSeparator": "\n"
      },
      "filter": {
        "name": "Reorder Required",
        "conditions": [
          [
            {
              "a": "{{1.stock}}",
              "b": "10",
              "o": "number:lessorequal"
            }
          ]
        ]
      },
      "mapper": {
        "value": "Product: {{1.title}}\r\nSKU: {{1.sku}}\r\nCategory: {{1.category}}\r\nStock: {{1.stock}}\r\nStatus: {{5.stock_status}}\r\nReorder quantity: {{5.reorder_quantity}}\r\nInventory value: £{{5.inventory_value}}\r\n--------------------"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        },
        "restore": {
          "extra": {
            "feeder": {
              "label": "HTTP - Make a request [1]"
            }
          },
          "parameters": {
            "rowSeparator": {
              "label": "New row"
            }
          }
        },
        "parameters": [
          {
            "name": "rowSeparator",
            "type": "select",
            "label": "Row separator",
            "validate": {
              "enum": [
                "\n",
                "\t",
                "other"
              ]
            }
          }
        ],
        "expect": [
          {
            "name": "value",
            "type": "text",
            "label": "Text"
          }
        ],
        "advanced": true
      },
      "flags": {
        "groupBy": "{{1.`__IMTLENGTH__`}}",
        "stopIfEmpty": true
      }
    },
    {
      "id": 7,
      "module": "google-email:sendAnEmail",
      "version": 4,
      "parameters": {},
      "mapper": {
        "to": [
          "inventory-alerts@example.com"
        ],
        "content": "<div style=\"font-family:Arial,sans-serif;max-width:700px;margin:auto;color:#222;\">\r\n  <h2 style=\"color:#b42318;\">Low-Stock Inventory Report</h2>\r\n\r\n  <p><strong>Generated:</strong>{{now}}</p>\r\n\r\n  <p>The following products require replenishment:</p>\r\n\r\n  <pre style=\"font-family:Arial,sans-serif;white-space:pre-wrap;background:#f6f6f6;padding:16px;border-radius:6px;\">{{6.text}}</pre>\r\n\r\n  <h3>Stock rules</h3>\r\n  <ul>\r\n    <li><strong>Critical:</strong> 0–5 units</li>\r\n    <li><strong>Low Stock:</strong> 6–10 units</li>\r\n    <li><strong>Target stock:</strong> 20 units</li>\r\n  </ul>\r\n\r\n  <p>Please review the suggested reorder quantities.</p>\r\n</div>",
        "subject": "ACTION REQUIRED — Low-Stock Inventory Report",
        "bodyType": "rawHtml"
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        },
        "restore": {
          "expect": {
            "cc": {
              "mode": "chose"
            },
            "to": {
              "mode": "chose",
              "items": [
                null
              ]
            },
            "bcc": {
              "mode": "chose"
            },
            "from": {
              "mode": "chose"
            },
            "bodyType": {
              "label": "Raw HTML"
            },
            "attachments": {
              "mode": "chose"
            },
            "emailHeaders": {
              "mode": "chose"
            }
          },
          "parameters": {}
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:google-email",
            "label": "Connection",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "to",
            "spec": {
              "name": "value",
              "type": "email",
              "label": "Recipient email address",
              "required": true,
              "validate": true
            },
            "type": "array",
            "label": "To",
            "required": true
          },
          {
            "name": "subject",
            "type": "text",
            "label": "Subject"
          },
          {
            "name": "bodyType",
            "type": "select",
            "label": "Body type",
            "required": true,
            "validate": {
              "enum": [
                "rawHtml",
                "collection"
              ]
            }
          },
          {
            "name": "attachments",
            "spec": {
              "name": "value",
              "spec": [
                {
                  "name": "filename",
                  "type": "filename",
                  "label": "File name",
                  "required": true,
                  "semantic": "file:name"
                },
                {
                  "name": "data",
                  "type": "buffer",
                  "label": "Data",
                  "required": true,
                  "semantic": "file:data"
                }
              ],
              "type": "collection",
              "label": "Attachment"
